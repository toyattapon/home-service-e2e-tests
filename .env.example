# Absolute path to the home_service_qa_demo checkout (the System Under Test).
# Used only by scripts/start-sut.sh / stop-sut.sh to boot the SUT for you.
SUT_DIR=/Users/mctroy/Documents/Coding Project/home_service_qa_demo

# Where the web app and API are reachable. Match the SUT's own defaults
# (README.md / .env.example in home_service_qa_demo) unless you changed them.
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000/api

# Demo accounts (see home_service_qa_demo/README.md). Not real secrets.
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=password123
TECH_EMAIL=tech@demo.com
TECH_PASSWORD=password123
